# ===== RDS (MySQL 기준. PostgreSQL이면 아래 3줄만 바꾸면 됨) =====
SPRING_DATASOURCE_URL=jdbc:mysql://<RDS엔드포인트>:3306/<DB이름>
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQL8Dialect
SPRING_SQL_INIT_MODE=never

# PostgreSQL로 쓸 경우:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<RDS엔드포인트>:5432/<DB이름>
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# ===== Cloudflare R2 (S3 호환 API) =====
R2_ACCOUNT_ID=<Cloudflare 계정 ID>
R2_ACCESS_KEY_ID=<R2 Access Key>
R2_SECRET_ACCESS_KEY=<R2 Secret Key>
R2_BUCKET_NAME=<버킷명>
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# 로컬 개발 확인용 public access 주소
R2_PUBLIC_BASE_URL=

KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=

REDIS_PORT=6379
# 로컬 docker MySQL 계정 (원래 RDS 계정: bbangpatrol/0921)
DB_USERNAME=root
DB_PASSWORD=root